%% =====================================================================
%  X型翼雅可比矩阵拟合 - 强制物理对称版本 (修复版)
%  =====================================================================
clear; clc; close all;

%% 1. 多文件选择
[files, path] = uigetfile('*.csv', '选择黑匣子CSV文件', 'MultiSelect', 'on');
if isequal(files, 0)
    disp('未选择文件'); return;
end
if ischar(files), files = {files}; end
fprintf('已选择 %d 个文件\n', length(files));

%% 2. 读取并合并数据
opts = delimitedTextImportOptions("NumVariables", 15);
opts.VariableNames = ["timestamp", "statemachine", "angle_roll", "angle_pitch", "angle_yaw", ...
    "gyro_x", "gyro_y", "gyro_z", "acc_x", "acc_y", "acc_z", ...
    "rudder1", "rudder2", "rudder3", "rudder4"];
opts.VariableTypes = repmat("double", 1, 15);
opts.DataLines = [2, Inf];

dataAll = [];
for i = 1:length(files)
    fullPath = fullfile(path, files{i});
    try
        dataRaw = readtable(fullPath, opts);
        fprintf('文件 %d: %s - %d 行\n', i, files{i}, height(dataRaw));
        dataAll = [dataAll; dataRaw];
    catch
        fprintf('警告: %s 读取失败\n', files{i});
    end
end
data = rmmissing(dataAll);
fprintf('总数据: %d 行\n', height(data));

%% 3. 提取变量
time_s = (data.timestamp - data.timestamp(1)) / 1000;

% 舵面 (度) - 顺序: FR, FL, BL, BR
delta_FR = data.rudder1;
delta_FL = data.rudder2;
delta_BL = data.rudder4;
delta_BR = data.rudder3;

% 角速度 (度/秒)
gyro_roll  = data.gyro_x;
gyro_pitch = data.gyro_y;
gyro_yaw   = data.gyro_z;

%% 4. 构建数据矩阵
Delta = [delta_FR, delta_FL, delta_BL, delta_BR];
Omega = [gyro_roll, gyro_pitch, gyro_yaw];
N = size(Delta, 1);

%% 5. 当前使用的雅可比矩阵 (您代码中的值)
%       FR      FL      BL      BR
J_current = [+1.00, -1.00, -0.50, +0.50;   % Roll
             +0.00, +0.00, +0.35, +0.35;   % Pitch
             +0.00, -0.00, +0.20, -0.20];  % Yaw

%% 6. 强制物理对称约束拟合
fprintf('\n===== 强制物理对称拟合 =====\n');

% 组合变量
diff_front = delta_FR - delta_FL;
diff_back  = delta_BR - delta_BL;
sum_back   = delta_BL + delta_BR;

% Roll模型
X_roll = [diff_front, diff_back];
y_roll = gyro_roll;

% Pitch模型
X_pitch = sum_back;
y_pitch = gyro_pitch;

% Yaw模型
X_yaw = [diff_front, -diff_back];
y_yaw = gyro_yaw;

% 岭回归求解
lambda = 0.01;

theta_roll = (X_roll' * X_roll + lambda * eye(2)) \ (X_roll' * y_roll);
a = theta_roll(1);
b = theta_roll(2);

theta_pitch = (X_pitch' * X_pitch + lambda) \ (X_pitch' * y_pitch);
c = theta_pitch;

theta_yaw = (X_yaw' * X_yaw + lambda * eye(2)) \ (X_yaw' * y_yaw);
d = theta_yaw(1);
e = theta_yaw(2);

fprintf('拟合参数:\n');
fprintf('  a (前翼Roll)  = %.4f\n', a);
fprintf('  b (后翼Roll)  = %.4f\n', b);
fprintf('  c (后翼Pitch) = %.4f\n', c);
fprintf('  d (前翼Yaw)   = %.4f\n', d);
fprintf('  e (后翼Yaw)   = %.4f\n', e);

%% 7. 构建对称雅可比矩阵
J_sym = [+a,    -a,     -b,     +b;
         0,      0,     +c,     +c;
         +d,    -d,     +e,     -e];

fprintf('\n===== 拟合的雅可比矩阵 (原始) =====\n');
fprintf('       FR          FL          BL          BR\n');
fprintf('Roll:  %+.4f     %+.4f     %+.4f     %+.4f\n', J_sym(1,:));
fprintf('Pitch: %+.4f     %+.4f     %+.4f     %+.4f\n', J_sym(2,:));
fprintf('Yaw:   %+.4f     %+.4f     %+.4f     %+.4f\n', J_sym(3,:));

%% 8. 计算R²
y_pred_roll = X_roll * theta_roll;
R2_roll = 1 - sum((y_roll - y_pred_roll).^2) / sum((y_roll - mean(y_roll)).^2);

y_pred_pitch = X_pitch * theta_pitch;
R2_pitch = 1 - sum((y_pitch - y_pred_pitch).^2) / sum((y_pitch - mean(y_pitch)).^2);

y_pred_yaw = X_yaw * theta_yaw;
R2_yaw = 1 - sum((y_yaw - y_pred_yaw).^2) / sum((y_yaw - mean(y_yaw)).^2);

fprintf('\n拟合优度:\n');
fprintf('  R²_Roll  = %.4f\n', R2_roll);
fprintf('  R²_Pitch = %.4f\n', R2_pitch);
fprintf('  R²_Yaw   = %.4f\n', R2_yaw);

%% 9. 归一化 (以|a|=1为基准)
if abs(a) > 0.01
    scale = 1.0 / abs(a);
    J_normalized = J_sym * scale;
    
    % 如果a为负，翻转符号使FR为正
    if a < 0
        J_normalized = -J_normalized;
    end
    
    fprintf('\n===== 归一化雅可比矩阵 (FR Roll = +1) =====\n');
    fprintf('       FR          FL          BL          BR\n');
    fprintf('Roll:  %+.4f     %+.4f     %+.4f     %+.4f\n', J_normalized(1,:));
    fprintf('Pitch: %+.4f     %+.4f     %+.4f     %+.4f\n', J_normalized(2,:));
    fprintf('Yaw:   %+.4f     %+.4f     %+.4f     %+.4f\n', J_normalized(3,:));
else
    J_normalized = J_sym;
    fprintf('警告: a值过小，无法归一化\n');
end

%% 10. C代码输出
fprintf('\n===== C代码输出 =====\n');
fprintf('// 拟合雅可比矩阵 (物理对称约束)\n');
fprintf('// 顺序: FR, FL, BL, BR\n');
fprintf('float JM[3][4] = {\n');
fprintf('    {%+.2f, %+.2f, %+.2f, %+.2f},  // Roll\n', J_normalized(1,:));
fprintf('    {%+.2f, %+.2f, %+.2f, %+.2f},  // Pitch\n', J_normalized(2,:));
fprintf('    {%+.2f, %+.2f, %+.2f, %+.2f}   // Yaw\n', J_normalized(3,:));
fprintf('};\n');

%% 11. 可视化
figure('Name', 'X型翼雅可比拟合', 'Position', [100, 100, 1400, 800]);

% 时序图
subplot(2,3,1);
plot(time_s, [delta_FR, delta_FL, delta_BL, delta_BR]);
xlabel('时间 (s)'); ylabel('舵面 (度)');
title('舵面偏转'); legend('FR', 'FL', 'BL', 'BR');
grid on;

subplot(2,3,2);
plot(time_s, [gyro_roll, gyro_pitch, gyro_yaw]);
xlabel('时间 (s)'); ylabel('角速度 (度/s)');
title('角速度'); legend('Roll', 'Pitch', 'Yaw');
grid on;

% R²
subplot(2,3,3);
bar([R2_roll, R2_pitch, R2_yaw]);
set(gca, 'XTickLabel', {'Roll', 'Pitch', 'Yaw'});
ylabel('R²'); title('拟合优度');
ylim([0, 1]); grid on;

% 当前雅可比热力图
subplot(2,3,4);
imagesc(J_current);
colorbar; colormap(gca, 'jet'); caxis([-1.5, 1.5]);
set(gca, 'XTick', 1:4, 'XTickLabel', {'FR','FL','BL','BR'});
set(gca, 'YTick', 1:3, 'YTickLabel', {'Roll','Pitch','Yaw'});
title('当前雅可比矩阵');
for i = 1:3
    for j = 1:4
        text(j, i, sprintf('%.2f', J_current(i,j)), ...
            'HorizontalAlignment', 'center', 'FontWeight', 'bold', 'Color', 'w');
    end
end

% 拟合雅可比热力图
subplot(2,3,5);
imagesc(J_normalized);
colorbar; colormap(gca, 'jet'); caxis([-1.5, 1.5]);
set(gca, 'XTick', 1:4, 'XTickLabel', {'FR','FL','BL','BR'});
set(gca, 'YTick', 1:3, 'YTickLabel', {'Roll','Pitch','Yaw'});
title('拟合雅可比矩阵');
for i = 1:3
    for j = 1:4
        text(j, i, sprintf('%.2f', J_normalized(i,j)), ...
            'HorizontalAlignment', 'center', 'FontWeight', 'bold', 'Color', 'w');
    end
end

% 预测对比
subplot(2,3,6);
Omega_pred = Delta * J_sym';
plot(gyro_roll, Omega_pred(:,1), '.', 'MarkerSize', 2); hold on;
plot(gyro_pitch, Omega_pred(:,2), '.', 'MarkerSize', 2);
plot(gyro_yaw, Omega_pred(:,3), '.', 'MarkerSize', 2);
lim_val = max([abs(gyro_roll); abs(gyro_pitch); abs(gyro_yaw)]) * 1.1;
plot([-lim_val, lim_val], [-lim_val, lim_val], 'k--', 'LineWidth', 2);
xlabel('实际 (度/s)'); ylabel('预测 (度/s)');
title('拟合效果'); legend('Roll', 'Pitch', 'Yaw', '理想', 'Location', 'best');
axis equal; grid on;

sgtitle('X型翼雅可比矩阵物理对称拟合');

fprintf('\n===== 完成 =====\n');